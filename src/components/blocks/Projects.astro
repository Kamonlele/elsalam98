---
import type { Locale } from '../../lib/brand';
import type { Block } from '../../lib/content';
import { t } from '../../lib/i18n';
import { publicUrl, type Site } from '../../lib/routes';
import Img from '../Img.astro';

interface Props { block: Extract<Block, { kind: 'projects' }>; locale: Locale; site: Site; heading: 'h1' | 'h2' }
const { block, locale, site, heading: H } = Astro.props;
const title = t(block.title, locale);
const items = (block.category ? site.projects.filter((p) => p.category === block.category) : site.projects).slice(0, block.limit ?? 6);
const Sub = H === 'h1' ? 'h2' : 'h3';
---
{items.length > 0 && (
  <section class="blk wrap b-cards" data-reveal>
    {title && <H>{title}</H>}
    <div class="product-list">
      {items.map((p) => {
        const cover = p.cover ?? p.photos[0]?.src;
        const meta = [p.place, p.year].filter(Boolean).join(' · ');
        return (
          <a class="product-card" href={publicUrl('projects', p, locale)}>
            <div class="pic">{cover ? <Img src={cover} alt="" sizes="(min-width: 1000px) 33vw, (min-width: 600px) 50vw, 100vw" /> : <span>{t(p.title, locale)}</span>}</div>
            <Sub>{t(p.title, locale)}</Sub>
            {meta && <p>{meta}</p>}
          </a>
        );
      })}
    </div>
  </section>
)}
