---
import type { Locale } from '../../lib/brand';
import type { Block } from '../../lib/content';
import { t } from '../../lib/i18n';

interface Props { block: Extract<Block, { kind: 'stats' }>; locale: Locale; heading: 'h1' | 'h2' }
const { block, locale, heading: H } = Astro.props;
const title = t(block.title, locale);
const note = t(block.note, locale);
---
<section class="blk wrap b-stats" data-reveal>
  {title && <H>{title}</H>}
  <dl style={`--n:${block.items.length}`}>
    {block.items.map((it) => (
      <div>
        <dt>{t(it.label, locale)}</dt>
        <dd>{t(it.value, locale)}</dd>
      </div>
    ))}
  </dl>
  {note && <p class="b-stats-note">{note}</p>}
</section>
