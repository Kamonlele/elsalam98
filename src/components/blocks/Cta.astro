---
import type { Locale } from '../../lib/brand';
import type { Block } from '../../lib/content';
import { t } from '../../lib/i18n';
import Paras from './Paras.astro';

interface Props { block: Extract<Block, { kind: 'cta' }>; locale: Locale; heading: 'h1' | 'h2' }
const { block, locale, heading: H } = Astro.props;
---
<section class="blk b-cta" data-reveal>
  <div class="wrap">
    <H>{t(block.title, locale)}</H>
    <Paras text={t(block.text, locale)} />
    <a class="btn" href={block.cta.href}>{t(block.cta.label, locale)}</a>
  </div>
</section>
