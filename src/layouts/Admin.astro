---
import '../styles/fonts.css';
import '../styles/admin.css';
import { brand } from '../lib/brand';
import { themeCss } from '../lib/theme';
import { SCHEMAS, schemaOn } from '../lib/schema';
import { features } from '../lib/brand';
import { countNew } from '../lib/booking';
import { countNewLeads } from '../lib/leads';
import { canOpen } from '../lib/roles';

interface Props { title: string; current?: string; bare?: boolean }
const { title, current, bare = false } = Astro.props;
const user = Astro.locals.user;
const role = user?.role ?? 'autore';
const isAdmin = role === 'admin';
const pending = !bare && isAdmin && features.booking ? await countNew().catch(() => 0) : 0;
const newLeads = !bare && isAdmin && features.leads ? await countNewLeads().catch(() => 0) : 0;
// Il menu rispecchia i permessi del server (canOpen): non li decide.
const nav = [
  ...(features.booking ? [{ href: '/admin/prenotazioni', label: 'Prenotazioni', id: 'prenotazioni', count: pending, hint: 'da confermare' }] : []),
  ...(features.leads ? [{ href: '/admin/richieste', label: 'Richieste', id: 'richieste', count: newLeads, hint: 'nuove' }] : []),
  ...Object.values(SCHEMAS).filter(schemaOn).map((s) => ({ href: `/admin/${s.section}`, label: s.plural, id: s.section, count: 0, hint: '' })),
  { href: '/admin/redirect', label: 'Redirect', id: 'redirect', count: 0, hint: '' },
  { href: '/admin/impostazioni', label: 'Impostazioni', id: 'impostazioni', count: 0, hint: '' },
  { href: '/admin/accessi', label: isAdmin ? 'Accessi' : 'La tua password', id: 'accessi', count: 0, hint: '' },
].filter((n) => canOpen(role, n.href, 'GET'));
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Area riservata</title>
    <style set:html={themeCss()}></style>
  </head>
  <body>
    {bare ? (
      <main class="auth"><slot /></main>
    ) : (
      <div class="shell">
        <aside class="side">
          <div class="site">{brand.identity.name}<small>Area riservata</small></div>
          <nav aria-label="Sezioni">
            {nav.map((n) => (
              <a href={n.href} aria-current={current === n.id ? 'page' : undefined}>
                {n.label}{n.count > 0 && <span class="count" aria-label={`${n.count} ${n.hint}`}>{n.count}</span>}
              </a>
            ))}
          </nav>
          <div class="foot">
            {user && <span class="who">{user.name}</span>}
            <a href="/" target="_blank" rel="noopener">Vedi il sito</a>
            <button class="linkish" type="button" id="logout">Esci</button>
          </div>
        </aside>
        <main class="main"><slot /></main>
      </div>
    )}
    <script>
      import { api } from '../scripts/admin/ui';
      document.getElementById('logout')?.addEventListener('click', async () => {
        await api('/api/admin/session', { method: 'DELETE' }).catch(() => null);
        location.href = '/admin/accedi';
      });
    </script>
  </body>
</html>
