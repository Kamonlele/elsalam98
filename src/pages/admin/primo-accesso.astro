---
import Admin from '../../layouts/Admin.astro';
import { countAdmins } from '../../lib/auth';
import { brand } from '../../lib/brand';

// Questa pagina si chiude da sola appena esiste il primo utente.
if ((await countAdmins()) > 0) return Astro.redirect(Astro.locals.user ? '/admin' : '/admin/accedi');
---
<Admin title="Primo accesso" bare>
  <form class="card" id="setup" novalidate>
    <div>
      <h1>Benvenuto</h1>
      <p>Crea l'accesso per gestire il sito di {brand.identity.name}. Potrai aggiungere altre persone dopo.</p>
    </div>
    <div class="fields">
      <div class="field"><label for="name">Nome</label><input id="name" name="name" type="text" autocomplete="name" /></div>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="username" required /></div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required />
        <span class="help">Almeno 10 caratteri, con lettere e numeri.</span>
      </div>
    </div>
    <p class="msg" role="alert"></p>
    <button class="btn" type="submit">Crea l'accesso</button>
  </form>
</Admin>
<script>
  import { bindForm } from '../../scripts/admin/ui';
  bindForm(document.getElementById('setup') as HTMLFormElement, '/api/admin/setup', 'POST', () => { location.href = '/admin'; });
</script>
